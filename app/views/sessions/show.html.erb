<div class="mx-auto max-w-3xl space-y-6">
  <div class="rounded-lg border border-zinc-200 dark:border-zinc-800/80 bg-white dark:bg-zinc-900/70 p-6">
    <p class="text-sm text-zinc-600 dark:text-zinc-400"><%= link_to @conference.name, conference_path(@conference), class: "hover:text-emerald-600 dark:hover:text-emerald-300" %></p>
    <h1 class="mt-2 text-2xl font-bold text-zinc-950 dark:text-zinc-50"><%= @session.title %></h1>
    <p class="mt-1 text-zinc-600 dark:text-zinc-400"><%= @session.speaker_name %></p>
    <p class="mt-3 text-sm text-zinc-600 dark:text-zinc-400"><%= session_datetime_and_room(@session) %></p>
    <% if @session.description.present? %>
      <p class="mt-5 whitespace-pre-line text-zinc-700 dark:text-zinc-300"><%= @session.description %></p>
    <% end %>
    <div class="mt-6 flex flex-wrap gap-3">
      <%= link_to t("ui.conferences.send_feedback"), public_feedback_path(@session.id), class: "rounded-md bg-emerald-400 px-4 py-3 text-sm font-semibold text-zinc-950 hover:bg-emerald-300" %>
      <% if @session.slide_deck.attached? %>
        <%= link_to t("ui.sessions.slide_deck"), rails_blob_path(@session.slide_deck, disposition: "inline"), class: "rounded-md border border-zinc-300 dark:border-zinc-700 bg-white dark:bg-zinc-900 px-4 py-3 text-sm font-semibold text-zinc-900 dark:text-zinc-100 hover:bg-zinc-100 dark:hover:bg-zinc-800" %>
      <% end %>
    </div>
  </div>
</div>
