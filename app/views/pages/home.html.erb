<section class="home-intro" aria-labelledby="home-title">
  <h1 id="home-title"><%= t("app.name") %></h1>
  <p class="page-lead mt-3"><%= t("pages.home.lead") %></p>
</section>

<section class="talk-picker" aria-labelledby="talk-picker-title">
  <div class="page-heading">
    <div>
      <h2 id="talk-picker-title" class="section-title"><%= t("pages.home.conferences") %></h2>
    </div>
    <% if authenticated? %>
      <%= link_to t("pages.home.dashboard"), conferences_path, class: "button-secondary" %>
    <% end %>
  </div>

  <% if @conferences.any? %>
    <ul class="conference-list">
      <% @conferences.each do |conference| %>
        <li>
          <%= link_to public_conference_path(conference), class: "conference-list__link" do %>
            <span class="conference-list__date"><%= conference_date_range(conference) %></span>
            <div class="min-w-0">
              <h3 class="section-title"><%= conference.name %></h3>
              <% if conference.venue.present? %>
                <p class="muted mt-1 text-sm"><%= conference.venue %></p>
              <% end %>
            </div>
            <span class="conference-list__action"><%= t("pages.home.view_talks") %></span>
          <% end %>
        </li>
      <% end %>
    </ul>
  <% else %>
    <div class="empty-state mt-5">
      <p><%= t("pages.home.empty") %></p>
      <% if authenticated? %>
        <%= link_to t("pages.home.dashboard"), conferences_path, class: "button-secondary mt-4" %>
      <% end %>
    </div>
  <% end %>
</section>
