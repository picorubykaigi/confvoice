<div class="mx-auto max-w-2xl rounded-lg border border-zinc-200 dark:border-zinc-800/80 bg-white dark:bg-zinc-900/70 p-6">
  <div class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
    <div>
      <h1 class="text-2xl font-bold text-zinc-950 dark:text-zinc-50"><%= @user.name %></h1>
      <p class="mt-1 text-zinc-600 dark:text-zinc-400"><%= @user.email_address %></p>
    </div>
    <%= link_to t("ui.common.edit"), edit_admin_user_path(@user), class: "rounded-md border border-zinc-300 dark:border-zinc-700 bg-white dark:bg-zinc-900 px-3 py-2 text-sm font-semibold hover:bg-zinc-100 dark:hover:bg-zinc-800" %>
  </div>
  <dl class="mt-6 grid gap-4 sm:grid-cols-2">
    <div>
      <dt class="text-sm text-zinc-600 dark:text-zinc-400"><%= t("ui.admin_users.role") %></dt>
      <dd class="font-medium"><%= t("roles.#{@user.role}") %></dd>
    </div>
    <div>
      <dt class="text-sm text-zinc-600 dark:text-zinc-400"><%= t("ui.admin_users.conferences") %></dt>
      <dd class="font-medium"><%= @user.conferences.count %></dd>
    </div>
  </dl>
</div>
</div>
