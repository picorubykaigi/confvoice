<div class="space-y-8">
  <section class="space-y-4">
    <div class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
      <div>
        <p class="muted text-sm"><%= @conference.published? ? t("ui.conferences.published") : t("ui.conferences.draft") %></p>
        <h1 class="page-title mt-2"><%= @conference.name %></h1>
        <p class="mt-2 text-zinc-600 dark:text-zinc-400"><%= conference_location_and_date(@conference) %></p>
      </div>
      <% if authenticated? && organizer_for?(@conference) %>
        <div class="flex flex-wrap gap-2">
          <%= link_to t("ui.common.edit"), edit_conference_path(@conference), class: "rounded-md border border-zinc-300 dark:border-zinc-700 bg-white dark:bg-zinc-900 px-3 py-2 text-sm font-semibold hover:bg-zinc-100 dark:hover:bg-zinc-800" %>
          <%= link_to t("ui.conferences.manage_sessions"), conference_manage_sessions_path(@conference), class: "rounded-md bg-zinc-100 px-3 py-2 text-sm font-semibold text-zinc-950 hover:bg-white" %>
        </div>
      <% end %>
    </div>
    <% if @conference.description.present? %>
      <p class="max-w-3xl whitespace-pre-line text-zinc-700 dark:text-zinc-300"><%= @conference.description %></p>
    <% end %>
  </section>

  <section class="space-y-4">
    <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
      <h2 class="text-xl font-semibold text-zinc-950 dark:text-zinc-50"><%= t("ui.conferences.sessions") %></h2>
      <%= link_to t("ui.conferences.view_all"), conference_sessions_path(@conference), class: "text-sm font-semibold text-emerald-600 dark:text-emerald-300 hover:text-emerald-700 dark:hover:text-emerald-200" %>
    </div>

    <% if @sessions.any? %>
      <div class="space-y-6">
        <% session_date_groups(@sessions).each do |date, sessions| %>
          <section class="space-y-3">
            <h3 class="text-base font-semibold text-zinc-950 dark:text-zinc-50"><%= l(date) %></h3>

            <div class="grid gap-4 md:grid-cols-2">
              <% sessions.each do |session| %>
                <article class="rounded-lg border border-zinc-200 dark:border-zinc-800/80 bg-white dark:bg-zinc-900/70 p-5">
                  <p class="inline-flex rounded-md bg-zinc-50 dark:bg-zinc-950/70 px-2.5 py-1 text-xs font-medium text-zinc-700 dark:text-zinc-300"><%= session_time_and_room(session) %></p>
                  <h4 class="mt-2 text-lg font-semibold"><%= link_to session.title, public_feedback_path(session.id), class: "hover:text-emerald-600 dark:hover:text-emerald-300" %></h4>
                  <p class="mt-1 text-sm text-zinc-600 dark:text-zinc-400"><%= session.speaker_name %></p>
                  <div class="mt-4">
                    <%= link_to t("ui.conferences.send_feedback"), public_feedback_path(session.id), class: "rounded-md bg-emerald-400 px-3 py-2 text-sm font-semibold text-zinc-950 hover:bg-emerald-300" %>
                  </div>
                </article>
              <% end %>
            </div>
          </section>
        <% end %>
      </div>
    <% else %>
      <div class="rounded-lg border border-dashed border-zinc-300 dark:border-zinc-700 bg-white dark:bg-zinc-900/70 p-8 text-center text-zinc-600 dark:text-zinc-400">
        <%= t("ui.conferences.empty_sessions") %>
      </div>
    <% end %>
  </section>
</div>
