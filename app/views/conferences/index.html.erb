<div class="space-y-8">
  <div class="page-heading">
    <h1 class="page-title"><%= t("ui.conferences.title") %></h1>
    <%= link_to t("ui.conferences.new"), new_conference_path, class: "button-primary" %>
  </div>

  <% if @conferences.any? %>
    <div class="conference-list">
      <% @conferences.each do |conference| %>
        <article class="conference-list__row">
          <div class="min-w-0">
            <div class="flex flex-wrap items-center gap-3">
              <h2 class="section-title"><%= link_to conference.name, conference_path(conference), class: "text-link" %></h2>
              <span class="badge-neutral"><%= conference.published? ? t("ui.conferences.published") : t("ui.conferences.draft") %></span>
            </div>
            <p class="muted mt-2 text-sm"><%= conference_location_and_date(conference) %></p>
          </div>
          <div class="flex flex-wrap gap-2">
            <%= link_to t("ui.conferences.dashboard"), conference_dashboard_path(conference), class: "button-secondary" %>
            <%= link_to t("ui.conferences.manage_sessions"), conference_manage_sessions_path(conference), class: "button-secondary" %>
            <%= link_to t("ui.sessions.qr_codes"), conference_qrcodes_path(conference), class: "button-ghost" %>
          </div>
        </article>
      <% end %>
    </div>
  <% else %>
    <div class="empty-state">
      <p><%= t("ui.conferences.empty") %></p>
      <%= link_to t("ui.conferences.new"), new_conference_path, class: "button-primary mt-4" %>
    </div>
  <% end %>
</div>
