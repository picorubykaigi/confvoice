<% public_context = local_assigns.fetch(:public_context, false) %>
<% conference = local_assigns[:conference] %>

<header class="site-header">
  <div class="site-header__inner">
    <div class="flex min-w-0 items-center gap-3">
      <%= link_to t("app.name"), root_path, class: "site-brand shrink-0" %>

      <% if public_context && conference %>
        <span class="hidden h-5 w-px bg-zinc-200 dark:bg-zinc-700 sm:block"></span>
        <%= link_to conference.name, public_conference_path(conference), class: "site-conference-link hidden min-w-0 sm:block" %>
      <% end %>
    </div>

    <nav class="site-nav" aria-label="<%= t("app.nav.primary") %>">
      <%= link_to t("app.event_website"), "https://picorubykaigi.org/", class: "site-nav__link site-nav__event-link" %>
      <% if public_context %>
        <% if conference %>
          <%= link_to t("public_conferences.sessions_title"), public_conference_path(conference), class: "site-nav__link site-nav__talks-link" %>
        <% end %>
      <% else %>
        <%= link_to t("app.nav.conferences"), conferences_path, class: "site-nav__link" if authenticated? %>
        <% if current_user&.admin? %>
          <%= link_to t("app.nav.users"), admin_users_path, class: "site-nav__link site-nav__admin-link" %>
        <% end %>
      <% end %>

      <% unless public_context %>
        <% if authenticated? %>
          <span class="site-nav__user max-w-28 truncate px-2 text-xs font-semibold text-zinc-500 dark:text-zinc-400"><%= current_user.name %></span>
          <%= button_to t("app.nav.logout"), session_path, method: :delete, class: "site-nav__button" %>
        <% else %>
          <%= link_to t("app.nav.login"), new_session_path, class: "site-nav__link" %>
        <% end %>
      <% end %>
    </nav>
  </div>
</header>
