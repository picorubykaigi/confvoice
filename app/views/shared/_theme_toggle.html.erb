<button
  type="button"
  data-controller="theme"
  data-action="theme#toggle"
  aria-label="<%= t("app.theme.toggle") %>"
  aria-pressed="false"
  class="theme-switch"
>
  <span data-theme-target="lightLabel" class="theme-option" aria-hidden="true">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
      <circle cx="12" cy="12" r="3.5" />
      <path d="M12 2v2M12 20v2M4.93 4.93l1.42 1.42M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.42-1.42M17.66 6.34l1.41-1.41" />
    </svg>
    <span class="sr-only"><%= t("app.theme.light") %></span>
  </span>
  <span data-theme-target="darkLabel" class="theme-option" aria-hidden="true">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
      <path d="M20.4 15.1A8.5 8.5 0 0 1 8.9 3.6 8.5 8.5 0 1 0 20.4 15.1Z" />
    </svg>
    <span class="sr-only"><%= t("app.theme.dark") %></span>
  </span>
</button>
