<% feedback_count = local_assigns.fetch(:feedback_count) { session.feedbacks.visible_to_speaker.count } %>
<% average_rating = local_assigns.fetch(:average_rating) { session.feedbacks.visible_to_speaker.average(:rating)&.round(2) } %>

<section id="speaker_session_stats" class="rounded-lg border border-zinc-200 dark:border-zinc-800/80 bg-white dark:bg-zinc-900/70 p-5">
  <div class="grid gap-4 sm:grid-cols-3">
    <div>
      <p class="text-sm text-zinc-600 dark:text-zinc-400"><%= t("metrics.feedback_count") %></p>
      <p class="mt-1 text-3xl font-bold text-zinc-950 dark:text-zinc-50"><%= feedback_count %></p>
    </div>
    <div>
      <p class="text-sm text-zinc-600 dark:text-zinc-400"><%= t("metrics.average_rating") %></p>
      <p class="mt-1 text-3xl font-bold text-zinc-950 dark:text-zinc-50"><%= average_rating || t("ui.common.none") %></p>
    </div>
    <div>
      <p class="text-sm text-zinc-600 dark:text-zinc-400"><%= t("metrics.reactions") %></p>
      <div class="mt-2 flex flex-wrap gap-2">
        <% reaction_options.each do |kind, emoji| %>
          <span class="rounded-full bg-zinc-100 dark:bg-zinc-800 px-3 py-1 text-sm font-semibold text-zinc-700 dark:text-zinc-300"><%= emoji %> <%= reaction_count(session, kind) %></span>
        <% end %>
      </div>
    </div>
  </div>
</section>
