<div class="space-y-6">
  <div>
    <p class="text-sm text-zinc-600 dark:text-zinc-400"><%= @conference.name %></p>
    <h1 class="mt-1 text-2xl font-bold text-zinc-950 dark:text-zinc-50"><%= @session.title %></h1>
    <p class="mt-1 text-zinc-600 dark:text-zinc-400"><%= @session.speaker_name %></p>
  </div>

  <%= render "speaker_portals/session_stats", session: @session, feedback_count: @feedback_count, average_rating: @average_rating %>

  <% if @session.slide_deck.attached? %>
    <div class="rounded-lg border border-zinc-200 dark:border-zinc-800/80 bg-white dark:bg-zinc-900/70 p-5">
      <%= link_to t("speaker_portals.slide"), rails_blob_path(@session.slide_deck, disposition: "inline"), class: "font-semibold text-emerald-600 dark:text-emerald-300 hover:text-emerald-700 dark:hover:text-emerald-200" %>
    </div>
  <% end %>

  <% if @keywords.any? %>
    <% max_count = @keywords.first.last %>
    <section class="rounded-lg border border-zinc-200 dark:border-zinc-800/80 bg-white dark:bg-zinc-900/70 p-5">
      <h2 class="text-lg font-semibold text-zinc-950 dark:text-zinc-50"><%= t("speaker_portals.word_cloud") %></h2>
      <div class="mt-4 flex flex-wrap items-center gap-3">
        <% @keywords.each do |word, count| %>
          <span class="<%= keyword_size_class(count, max_count) %> rounded-full bg-emerald-50 dark:bg-emerald-400/10 px-3 py-1 font-semibold text-emerald-700 dark:text-emerald-200"><%= word %></span>
        <% end %>
      </div>
    </section>
  <% end %>

  <section class="space-y-3">
    <h2 class="text-lg font-semibold text-zinc-950 dark:text-zinc-50"><%= t("speaker_portals.latest_feedbacks") %></h2>
    <% if @feedbacks.any? %>
      <div class="space-y-3">
        <%= render partial: "feedbacks/feedback_card", collection: @feedbacks, as: :feedback %>
      </div>
    <% else %>
      <div class="rounded-lg border border-dashed border-zinc-300 dark:border-zinc-700 bg-white dark:bg-zinc-900/70 p-8 text-center text-zinc-600 dark:text-zinc-400">
        <%= t("speaker_portals.empty_feedbacks") %>
      </div>
    <% end %>
  </section>
</div>
