<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= content_for(:title) || t("app.name") %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Confvoice">
    <meta name="mobile-web-app-capable" content="yes">
    <%= render "shared/social_meta",
          title: content_for?(:og_title) ? content_for(:og_title) : t("app.name"),
          description: content_for?(:og_description) ? content_for(:og_description) : t("pages.home.lead"),
          url: request.original_url,
          image_url: default_og_image_url,
          image_type: ApplicationHelper::DEFAULT_OG_IMAGE_TYPE,
          image_alt: default_og_image_alt %>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <%= favicon_link_tag "/favicon.ico" %>
    <%= tag.link rel: "apple-touch-icon", href: "/logo.png" %>

    <%= render "shared/theme_boot" %>
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_include_tag "https://www.gstatic.com/charts/loader.js" %>
    <%= javascript_include_tag "chartkick" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="min-h-dvh antialiased">
    <%= render "shared/site_header" %>

    <main class="app-main mx-auto w-full max-w-6xl px-4 py-8 sm:py-10">
      <% flash.each do |type, message| %>
        <% tone = type.to_s == "alert" ? "flash-message--alert" : "flash-message--success" %>
        <div class="flash-message <%= tone %>" role="status">
          <%= message %>
        </div>
      <% end %>

      <%= yield %>
    </main>
  </body>
</html>
