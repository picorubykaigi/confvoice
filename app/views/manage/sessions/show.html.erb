<div class="mx-auto max-w-3xl space-y-6">
  <div class="rounded-lg border border-zinc-200 dark:border-zinc-800/80 bg-white dark:bg-zinc-900/70 p-6">
    <div class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
      <div>
        <p class="text-sm text-zinc-600 dark:text-zinc-400"><%= @conference.name %></p>
        <h1 class="mt-1 text-2xl font-bold text-zinc-950 dark:text-zinc-50"><%= @session.title %></h1>
        <p class="mt-1 text-zinc-600 dark:text-zinc-400"><%= @session.speaker_name %></p>
      </div>
      <%= link_to t("ui.common.edit"), edit_conference_manage_session_path(@conference, @session), class: "rounded-md border border-zinc-300 dark:border-zinc-700 bg-white dark:bg-zinc-900 px-3 py-2 text-sm font-semibold hover:bg-zinc-100 dark:hover:bg-zinc-800" %>
    </div>
    <dl class="mt-6 grid gap-4 sm:grid-cols-2">
      <div>
        <dt class="text-sm text-zinc-600 dark:text-zinc-400"><%= t("ui.sessions.time") %></dt>
        <dd class="font-medium"><%= short_datetime(@session.starts_at) %> - <%= short_datetime(@session.ends_at) %></dd>
      </div>
      <div>
        <dt class="text-sm text-zinc-600 dark:text-zinc-400"><%= t("ui.sessions.room") %></dt>
        <dd class="font-medium"><%= @session.room.presence || t("ui.common.not_set") %></dd>
      </div>
      <div>
        <dt class="text-sm text-zinc-600 dark:text-zinc-400"><%= t("ui.dashboard.feedback_count") %></dt>
        <dd class="font-medium"><%= @session.feedbacks_count %></dd>
      </div>
      <div>
        <dt class="text-sm text-zinc-600 dark:text-zinc-400"><%= t("ui.dashboard.average_rating") %></dt>
        <dd class="font-medium"><%= @session.average_rating || t("ui.common.none") %></dd>
      </div>
      <div>
        <dt class="text-sm text-zinc-600 dark:text-zinc-400"><%= t("ui.sessions.reactions") %></dt>
        <dd class="mt-1 flex flex-wrap gap-2">
          <% reaction_options.each do |kind, emoji| %>
            <span class="rounded-full bg-zinc-100 dark:bg-zinc-800 px-3 py-1 text-sm font-semibold text-zinc-700 dark:text-zinc-300"><%= emoji %> <%= reaction_count(@session, kind) %></span>
          <% end %>
        </dd>
      </div>
      <div>
        <dt class="text-sm text-zinc-600 dark:text-zinc-400"><%= t("ui.sessions.slide_deck") %></dt>
        <dd class="font-medium">
          <% if @session.slide_deck.attached? %>
            <%= link_to @session.slide_deck.filename.to_s, rails_blob_path(@session.slide_deck, disposition: "inline"), class: "text-emerald-600 dark:text-emerald-300 hover:text-emerald-700 dark:hover:text-emerald-200" %>
          <% else %>
            <%= t("ui.common.not_set") %>
          <% end %>
        </dd>
      </div>
    </dl>
    <div class="mt-6 rounded-lg border border-zinc-200 dark:border-zinc-800 bg-zinc-50 dark:bg-zinc-950 p-4">
      <h2 class="font-semibold text-zinc-950 dark:text-zinc-50"><%= t("ui.sessions.speaker_invite") %></h2>
      <% if (invite = @session.active_speaker_invite) %>
        <p class="mt-2 break-all text-sm text-zinc-600 dark:text-zinc-400"><%= speaker_portal_url(invite.token) %></p>
        <p class="mt-1 text-xs text-zinc-600 dark:text-zinc-400"><%= t("ui.sessions.expires_at") %>: <%= short_datetime(invite.expires_at) %></p>
        <div class="mt-3 flex flex-wrap gap-2">
          <%= link_to t("ui.sessions.open_portal"), speaker_portal_path(invite.token), class: "rounded-md border border-zinc-300 dark:border-zinc-700 bg-white dark:bg-zinc-900 px-3 py-2 text-sm font-semibold hover:bg-zinc-100 dark:hover:bg-zinc-800" %>
          <%= button_to t("ui.sessions.revoke"), conference_manage_session_speaker_invite_path(@conference, @session), method: :delete, class: "rounded-md border border-red-200 dark:border-red-500/40 bg-red-50 dark:bg-red-500/10 px-3 py-2 text-sm font-semibold text-red-700 dark:text-red-200 hover:bg-red-500/20" %>
        </div>
      <% else %>
        <p class="mt-2 text-sm text-zinc-600 dark:text-zinc-400"><%= t("ui.sessions.invite_help") %></p>
        <%= button_to t("ui.sessions.issue_invite"), conference_manage_session_speaker_invite_path(@conference, @session), method: :post, class: "mt-3 rounded-md bg-zinc-100 px-3 py-2 text-sm font-semibold text-zinc-950 hover:bg-white" %>
      <% end %>
    </div>
    <div class="mt-6 flex flex-wrap gap-2">
      <%= link_to t("ui.sessions.submission_page"), public_feedback_path(@conference, @session), class: "rounded-md bg-emerald-400 px-3 py-2 text-sm font-semibold text-zinc-950 hover:bg-emerald-300" %>
      <%= link_to t("ui.sessions.feedback_list"), conference_session_feedbacks_path(@conference, @session), class: "rounded-md border border-zinc-300 dark:border-zinc-700 bg-white dark:bg-zinc-900 px-3 py-2 text-sm font-semibold hover:bg-zinc-100 dark:hover:bg-zinc-800" %>
    </div>
  </div>
</div>
</div>
