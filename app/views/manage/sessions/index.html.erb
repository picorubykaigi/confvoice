<div class="space-y-6">
  <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
    <div>
      <p class="text-sm text-zinc-600 dark:text-zinc-400"><%= @conference.name %></p>
      <h1 class="text-2xl font-bold text-zinc-950 dark:text-zinc-50"><%= t("ui.sessions.manage_title") %></h1>
    </div>
    <div class="flex flex-wrap gap-2">
      <%= link_to t("ui.sessions.members"), conference_manage_memberships_path(@conference), class: "rounded-md border border-zinc-300 dark:border-zinc-700 bg-white dark:bg-zinc-900 px-3 py-2 text-sm font-semibold hover:bg-zinc-100 dark:hover:bg-zinc-800" %>
      <%= link_to t("ui.sessions.qr_codes"), conference_qrcodes_path(@conference), class: "rounded-md border border-zinc-300 dark:border-zinc-700 bg-white dark:bg-zinc-900 px-3 py-2 text-sm font-semibold hover:bg-zinc-100 dark:hover:bg-zinc-800" %>
      <%= link_to t("ui.sessions.new"), new_conference_manage_session_path(@conference), class: "rounded-md bg-zinc-100 px-3 py-2 text-sm font-semibold text-zinc-950 hover:bg-white" %>
    </div>
  </div>

  <div class="overflow-hidden rounded-lg border border-zinc-200 dark:border-zinc-800/80 bg-white dark:bg-zinc-900/70">
    <table class="min-w-full divide-y divide-zinc-200 dark:divide-zinc-800 text-sm">
      <thead class="bg-zinc-100 dark:bg-zinc-800 text-left text-zinc-600 dark:text-zinc-400">
        <tr>
          <th class="px-4 py-3 font-semibold"><%= t("ui.sessions.title") %></th>
          <th class="px-4 py-3 font-semibold"><%= t("ui.sessions.speaker") %></th>
          <th class="px-4 py-3 font-semibold"><%= t("ui.sessions.time") %></th>
          <th class="px-4 py-3 font-semibold"><%= t("ui.sessions.feedback") %></th>
          <th class="px-4 py-3 font-semibold"></th>
        </tr>
      </thead>
      <tbody class="divide-y divide-zinc-200 dark:divide-zinc-800">
        <% @sessions.each do |session| %>
          <tr>
            <td class="px-4 py-3 font-medium text-zinc-950 dark:text-zinc-50"><%= link_to session.title, conference_manage_session_path(@conference, session), class: "hover:text-emerald-600 dark:hover:text-emerald-300" %></td>
            <td class="px-4 py-3 text-zinc-600 dark:text-zinc-400"><%= session.speaker_name %></td>
            <td class="px-4 py-3 text-zinc-600 dark:text-zinc-400"><%= short_datetime(session.starts_at) %></td>
            <td class="px-4 py-3 text-zinc-600 dark:text-zinc-400"><%= t("ui.common.feedback_count", count: session.feedbacks_count) %></td>
            <td class="px-4 py-3 text-right"><%= link_to t("ui.common.edit"), edit_conference_manage_session_path(@conference, session), class: "font-semibold text-emerald-600 dark:text-emerald-300 hover:text-emerald-700 dark:hover:text-emerald-200" %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
